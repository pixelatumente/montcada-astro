---
import BaseLayout from "../layouts/BaseLayout.astro";
import data from "../data/enriched-negocios.json";
import contenidoCategorias from "../data/contenido-categorias.json";

const q = Astro.url.searchParams.get("q") || "";

// Normalize for matching
function normalize(s) {
  return s.toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .trim();
}

const query = normalize(q);
const words = query.split(/\s+/).filter(Boolean);

// Score and filter businesses
function score(biz) {
  const title = normalize(biz.title);
  const cat = normalize(biz.category);
  const excerpt = normalize(biz.excerpt || biz.clean_content || "");
  const e = biz.enriched || {};
  const address = normalize(e.google_address || "");

  // All words must match somewhere
  if (!words.every(w => title.includes(w) || cat.includes(w) || excerpt.includes(w) || address.includes(w))) {
    return -1;
  }

  let s = 0;
  const fullQuery = query;
  if (title === fullQuery) s += 100;
  else if (title.startsWith(fullQuery)) s += 80;
  else if (title.includes(fullQuery)) s += 60;
  else if (cat.includes(fullQuery)) s += 40;
  else if (excerpt.includes(fullQuery)) s += 20;
  else if (address.includes(fullQuery)) s += 10;

  words.forEach(w => {
    if (title.startsWith(w)) s += 10;
    else if (title.includes(" " + w)) s += 5;
  });

  // Rating bonus
  s += (e.google_rating || 0) * 2;
  return s;
}

let results = [];
if (words.length > 0) {
  results = data.negocios
    .map(b => ({ biz: b, score: score(b) }))
    .filter(r => r.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, 30)
    .map(r => r.biz);
}

// Also search categories
const catResults = words.length > 0 ? data.categories
  .filter(c => c.slug !== "mir")
  .filter(c => words.every(w => normalize(c.name).includes(w)))
  .slice(0, 5) : [];

const title = q ? `Resultados para "${q}" en Montcada i Reixac` : "Buscar negocios en Montcada i Reixac";
const desc = q
  ? `${results.length} resultados encontrados para "${q}" en Montcada i Reixac`
  : "Busca entre los más de 384 negocios, comercios y profesionales de Montcada i Reixac";

function stars(rating) {
  if (!rating) return "";
  const full = Math.floor(rating);
  const half = rating - full >= 0.3;
  let s = "★".repeat(full);
  if (half) s += "½";
  s += "☆".repeat(5 - full - (half ? 1 : 0));
  return s;
}

const categoryIcons = {
  "Restaurantes": "🍽️", "Talleres": "🔧", "Peluquerías": "💇",
  "Concesionarios": "🚗", "Fisioterapeutas": "💪", "Veterinarios": "🐾",
  "Abogados": "⚖️", "Dentistas": "🦷", "Supermercados": "🛒",
  "Farmacias": "💊", "Fontaneros": "🔧", "Electricistas": "⚡",
  "Reformas": "🏗️", "Ópticas": "👓", "Servicios públicos y trámites": "🏛️"
};
---

<BaseLayout title={title} description={desc.slice(0, 160)}>
  <!-- Hero search -->
  <section style="background:linear-gradient(135deg, var(--primary) 0%, #C94D3A 100%);padding:48px 24px;text-align:center;color:white">
    <div class="container">
      <h1 style="font-family:var(--font-serif);font-size:2.2rem;font-weight:700;margin-bottom:16px">
        {q ? `Resultados para "${q}"` : "Buscar negocios"}
      </h1>
      <form action="/buscar/" method="get" style="max-width:480px;margin:0 auto">
        <div style="display:flex;background:rgba(255,255,255,0.15);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.25);border-radius:100px;overflow:hidden">
          <input type="text" name="q" value={q} placeholder="Busca un negocio o categoría..." autocomplete="off"
            style="flex:1;background:none;border:none;outline:none;padding:14px 20px;font-size:1rem;font-family:inherit;color:white"
          />
          <button type="submit" style="background:none;border:none;cursor:pointer;padding:0 20px;color:rgba(255,255,255,0.7)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </section>

  <div class="container" style="padding:32px 24px 60px">
    {!q ? (
      <div style="text-align:center;padding:60px 0;color:var(--text-light)">
        <p style="font-size:1.1rem">Escribe en el buscador para encontrar negocios en Montcada i Reixac</p>
      </div>
    ) : results.length === 0 && catResults.length === 0 ? (
      <div style="text-align:center;padding:60px 0">
        <p style="font-size:1.1rem;color:var(--text-light);margin-bottom:8px">No encontramos resultados para <strong>"{q}"</strong></p>
        <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:24px">Prueba con otro término: "taller", "pizza", "peluquería"...</p>
        <a href="/" style="display:inline-block;padding:10px 24px;background:var(--primary);color:white;border-radius:8px;font-weight:600;font-size:0.9rem;text-decoration:none">Volver al inicio</a>
      </div>
    ) : (
      <>
        {catResults.length > 0 && (
          <section style="margin-bottom:32px">
            <h2 style="font-size:1.1rem;font-weight:600;color:var(--text-light);margin-bottom:12px">Categorías</h2>
            <div style="display:flex;flex-wrap:wrap;gap:8px">
              {catResults.map(c => (
                <a href={`/${c.slug}/`} style="display:inline-flex;align-items:center;gap:6px;padding:10px 20px;background:var(--card);border:1px solid var(--border);border-radius:100px;text-decoration:none;color:var(--text);font-weight:500;font-size:0.9rem;transition:all 0.2s"
                  onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--border)'">
                  {categoryIcons[c.name] || "📍"} {c.name}
                  <span style="color:var(--text-muted);font-size:0.8rem">({c.count})</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {results.length > 0 && (
          <section>
            <p style="color:var(--text-light);font-size:0.9rem;margin-bottom:16px">
              {results.length} {results.length === 1 ? "resultado" : "resultados"} encontrados
            </p>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px">
              {results.map(b => {
                const e = b.enriched || {};
                const catSlug = b.category.toLowerCase()
                  .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
                  .replace(/[\s|]+/g, "-").replace(/[^a-z0-9-]/g, "");
                const s = e.google_rating ? stars(e.google_rating) : "";
                return (
                  <a href={`/${catSlug}/${b.slug}/`} style="display:block;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;text-decoration:none;color:var(--text);transition:all 0.25s;box-shadow:var(--shadow-sm)"
                    onmouseover="this.style.boxShadow='var(--shadow-md)';this.style.transform='translateY(-3px)';this.style.borderColor='var(--primary)'"
                    onmouseout="this.style.boxShadow='var(--shadow-sm)';this.style.transform='translateY(0)';this.style.borderColor='var(--border)'">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px">
                      <h3 style="font-size:1rem;font-weight:600">{b.title}</h3>
                      <span style="font-size:0.75rem;color:var(--text-muted);background:var(--bg-alt);padding:2px 10px;border-radius:100px;white-space:nowrap">{b.category}</span>
                    </div>
                    {s && (
                      <div style="display:flex;align-items:center;gap:4px;margin-bottom:6px">
                        <span style="color:var(--accent);font-size:0.9rem;letter-spacing:1px">{s}</span>
                        <span style="font-size:0.85rem;font-weight:600">{e.google_rating}</span>
                        <span style="color:var(--text-muted);font-size:0.8rem">({e.google_reviews})</span>
                      </div>
                    )}
                    {e.google_address && (
                      <p style="font-size:0.8rem;color:var(--text-light)">📍 {e.google_address.split(",").slice(0,2).join(",")}</p>
                    )}
                    {b.phone && <p style="font-size:0.85rem;color:var(--text-light);margin-top:4px">📞 {b.phone}</p>}
                  </a>
                );
              })}
            </div>
          </section>
        )}
      </>
    )}
  </div>
</BaseLayout>
