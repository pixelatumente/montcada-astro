---
import BaseLayout from "../layouts/BaseLayout.astro";
import Schema from "../components/Schema.astro";
import data from "../data/enriched-negocios.json";
import contenidoCategorias from "../data/contenido-categorias.json";

export async function getStaticPaths() {
  return data.categories
    .filter(c => c.slug !== "tiempo" && c.slug !== "mir")
    .map(cat => ({
      params: { categoria: cat.slug },
      props: { category: cat }
    }));
}

const { category } = Astro.props;
const businesses = data.negocios.filter(n => n.category === category.name);
const enrichedBusinesses = businesses.filter(n => n.enriched?.google_place_id);
const title = `${category.name} en Montcada i Reixac`;
const desc = contenidoCategorias[category.name]?.seo_description || `Encuentra los mejores ${category.name.toLowerCase()} en Montcada i Reixac. Directorio con ${businesses.length} negocios, direcciones, teléfonos y opiniones.`;

const categoryIcons = {
  "Restaurantes": { icon: "🍽️", bg: "#FDF0ED" },
  "Talleres": { icon: "🔧", bg: "#E8F5F0" },
  "Fisioterapeutas": { icon: "💪", bg: "#EDE9FE" },
  "Peluquerías": { icon: "💇", bg: "#FCE7F3" },
  "Concesionarios": { icon: "🚗", bg: "#DBEAFE" },
  "Veterinarios": { icon: "🐾", bg: "#F0FDF4" },
  "Abogados": { icon: "⚖️", bg: "#FEF3C7" },
  "Dentistas": { icon: "🦷", bg: "#F0F9FF" },
  "Servicios públicos y trámites": { icon: "🏛️", bg: "#F1F5F9" },
  "Supermercados": { icon: "🛒", bg: "#E8F5E9" },
  "Farmacias": { icon: "💊", bg: "#E0F7FA" },
  "Fontaneros": { icon: "🔧", bg: "#FFF3E0" },
  "Electricistas": { icon: "⚡", bg: "#FFFDE7" },
  "Reformas": { icon: "🏗️", bg: "#F3E5F5" },
  "Ópticas": { icon: "👓", bg: "#E0F2FE" },
};
const catStyle = categoryIcons[category.name] || { icon: "📍", bg: "#F5F0EB" };

function stars(rating) {
  if (!rating) return "";
  const full = Math.floor(rating);
  const half = rating - full >= 0.3;
  let s = "★".repeat(full);
  if (half) s += "½";
  s += "☆".repeat(5 - full - (half ? 1 : 0));
  return s;
}
---

<BaseLayout title={title} description={desc}>
  <Schema type="BreadcrumbList" data={{
    items: [
      { name: "Inicio", url: "https://montcada.com.es/" },
      { name: category.name, url: `https://montcada.com.es/${category.slug}/` }
    ]
  }} />
  <Schema type="ItemList" data={{
    name: title,
    description: desc,
    numberOfItems: businesses.length,
    url: `https://montcada.com.es/${category.slug}/`,
    items: businesses.map(b => ({
      name: b.title,
      url: `https://montcada.com.es/${category.slug}/${b.slug}/`
    }))
  }} />

  <!-- FAQ Schema -->
  {contenidoCategorias[category.name]?.faqs && (
    <Schema type="FAQPage" data={{ questions: contenidoCategorias[category.name].faqs }} />
  )}

  <!-- Category Hero -->
  <section class="category-hero" style="background:linear-gradient(135deg, var(--primary) 0%, #C94D3A 100%);padding:56px 24px;text-align:center;color:white">
    <div class="container">
      <nav style="font-size:0.85rem;color:rgba(255,255,255,0.7);margin-bottom:20px">
        <a href="/" style="color:rgba(255,255,255,0.7)">Inicio</a>
        <span style="margin:0 8px">/</span>
        <span style="color:white;font-weight:500">{category.name}</span>
      </nav>

      <div style="display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:12px">
        <span class="cat-icon" style="font-size:2.5rem;width:56px;height:56px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.2);border-radius:16px;backdrop-filter:blur(4px)">{catStyle.icon}</span>
        <h1 style="font-family:var(--font-serif);font-size:2.8rem;font-weight:700;line-height:1.1">{title}</h1>
      </div>
      
      <div style="display:flex;justify-content:center;gap:24px;flex-wrap:wrap;margin-top:16px">
        <span style="display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,0.15);padding:6px 16px;border-radius:100px;font-size:0.9rem;backdrop-filter:blur(4px)">
          📍 Montcada i Reixac
        </span>
        <span style="display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,0.15);padding:6px 16px;border-radius:100px;font-size:0.9rem;backdrop-filter:blur(4px)">
          {businesses.length} negocios
        </span>
        {enrichedBusinesses.length > 0 && (
          <span style="display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,0.15);padding:6px 16px;border-radius:100px;font-size:0.9rem;backdrop-filter:blur(4px)">
            {enrichedBusinesses.length} verificados
          </span>
        )}
      </div>
    </div>
  </section>

  <!-- Editorial Content -->
  {contenidoCategorias[category.name] && (
    <section class="container" style="margin-top:-20px;margin-bottom:0">
      <div style="background:var(--card);border-radius:var(--radius);padding:32px 36px;border:1px solid var(--border);box-shadow:var(--shadow-sm);line-height:1.8;font-size:0.95rem;color:var(--text-light)">
        <p style="margin-bottom:0">{contenidoCategorias[category.name].intro}</p>
        {contenidoCategorias[category.name].outro && (
          <>
            <br/>
            <p style="margin-bottom:0">{contenidoCategorias[category.name].outro}</p>
          </>
        )}
      </div>
    </section>
  )}

  <!-- Trámites Hub: solo en la landing de servicios públicos (enlaces internos a fichas clave) -->
  {category.name === "Servicios públicos y trámites" && (
    <section class="container" style="padding:32px 24px 0">
      <div style="background:var(--card);border-radius:var(--radius);padding:28px 32px;border:1px solid var(--border);box-shadow:var(--shadow-sm)">
        <h2 style="font-family:var(--font-serif);font-size:1.4rem;font-weight:600;margin-bottom:4px;color:var(--text)">Resuelve tu trámite en Montcada</h2>
        <p style="font-size:0.9rem;color:var(--text-light);margin-bottom:20px">Acceso directo a los servicios públicos con más consultas: horarios y teléfonos actualizados.</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px">
          {
            [
              { slug: "cap-les-indianes", etiqueta: "🩺 CAP Les Indianes", desc: "Atención primaria + PAC en Can Sant Joan" },
              { slug: "cap-montcada-i-reixac", etiqueta: "🩺 CAP Montcada", desc: "Atención primaria del ICS en Montcada" },
              { slug: "correos-montcada-i-reixac", etiqueta: "📮 Correos", desc: "Envíos, certificados, burofax y giros" },
              { slug: "mossos-desquadra-montcada-i-reixac", etiqueta: "👮 Mossos d'Esquadra", desc: "Comisaría 24 horas en Pla de Matabous 2" },
              { slug: "policia-de-montcada-i-reixac", etiqueta: "🚓 Policía Local", desc: "Trámites y citas en Carrer Major 38" },
              { slug: "ayuntamiento-de-montcada-i-reixac", etiqueta: "🏛️ Ayuntamiento", desc: "Empadronamiento, licencias y trámites" }
            ].map(t => {
              // Prefer the canonical "Servicios públicos y trámites" ficha; some slugs also exist under Fisioterapeutas (historic duplicates)
              const ficha = data.negocios.find(n => n.slug === t.slug && n.category === "Servicios públicos y trámites")
                || data.negocios.find(n => n.slug === t.slug);
              if (!ficha) return null;
              const fCatSlug = ficha.category.toLowerCase()
                .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
                .replace(/[\s|]+/g, "-").replace(/[^a-z0-9-]/g, "");
              return (
                <a href={`/${fCatSlug}/${ficha.slug}/`} style="display:block;background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);padding:16px;text-decoration:none;color:var(--text);transition:all 0.2s"
                  onmouseover="this.style.boxShadow='var(--shadow-sm)';this.style.borderColor='var(--primary)'"
                  onmouseout="this.style.boxShadow='none';this.style.borderColor='var(--border)'">
                  <strong style="font-size:0.95rem;font-weight:600;display:block;margin-bottom:4px">{t.etiqueta}</strong>
                  <span style="font-size:0.82rem;color:var(--text-light);line-height:1.4">{t.desc}</span>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>
  )}

  <!-- Business Grid -->
  <section class="container" style="padding:40px 24px 60px">
    {businesses.length === 0 ? (
      <div style="text-align:center;padding:60px 0">
        <p style="font-size:1.1rem;color:var(--text-light)">No encontramos negocios en esta categoría.</p>
        <a href="/" style="display:inline-block;margin-top:16px;padding:10px 24px;background:var(--primary);color:white;border-radius:8px;font-weight:600;font-size:0.9rem">Volver al inicio</a>
      </div>
    ) : (
      <>
        <p style="color:var(--text-light);font-size:0.9rem;margin-bottom:24px">
          Mostrando {businesses.length} {businesses.length === 1 ? "negocio" : "negocios"}
        </p>
        <div class="business-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:18px">
          {businesses.map(b => {
            const ne = b.enriched || {};
            const r = ne.google_rating;
            const s = r ? stars(r) : "";
            return (
              <a href={`/${category.slug}/${b.slug}`} style="display:block;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:24px;text-decoration:none;color:var(--text);transition:all 0.25s ease;box-shadow:var(--shadow-sm)"
                onmouseover="this.style.boxShadow='var(--shadow-md)';this.style.transform='translateY(-3px)';this.style.borderColor='var(--primary)'"
                onmouseout="this.style.boxShadow='var(--shadow-sm)';this.style.transform='translateY(0)';this.style.borderColor='var(--border)'">
                <h3 style="font-size:1.1rem;font-weight:600;margin-bottom:6px">{b.title}</h3>
                
                {s && (
                  <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
                    <span style="color:#F59E0B;font-size:1rem;letter-spacing:1px">{s}</span>
                    <span style="font-weight:600;font-size:0.9rem">{r}</span>
                    <span style="color:var(--text-muted);font-size:0.8rem">({ne.google_reviews} reseñas)</span>
                  </div>
                )}
                
                {b.excerpt && <p style="font-size:0.85rem;color:var(--text-light);margin-bottom:8px;line-height:1.5">{b.excerpt}</p>}
                
                <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:8px">
                  {b.phone && <span style="font-size:0.85rem;color:var(--text-light)">📞 {b.phone}</span>}
                  {ne.google_website && <span style="font-size:0.85rem;color:var(--primary)">🌐 Web</span>}
                </div>
              </a>
            );
          })}
        </div>
      </>
    )}
  </section>
</BaseLayout>
